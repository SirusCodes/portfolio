---
import { getCollection } from "astro:content";
import { readFile } from "node:fs/promises";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ResumeBuilder } from "../components/resume-builder/ResumeBuilder";
import "../styles/resume-builder.css";

const experienceEntries = await getCollection("experience");
const projectEntries = await getCollection("projects");
const talksEntries = await getCollection("talksAndConferences");
const baseTex = await readFile("src/pages/resume.tex/_base.tex", "utf-8");

const collectionsData = {
	experience: experienceEntries.map((e) => e.data),
	projects: projectEntries.map((p) => p.data),
	talks: talksEntries.map((t) => t.data)
};
---

<BaseLayout>
	<meta name="robots" content="noindex, nofollow" slot="head" />
	<ResumeBuilder
		client:only="preact"
		collections={collectionsData}
		baseTemplate={baseTex}
	/>
</BaseLayout>
